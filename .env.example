# LUMO Commerce Platform — Environment Variables Example
# Copy this file to .env.local for local development. NEVER commit real production credentials.

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://username:password@localhost:5432/lumo_db?schema=public"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Session & JWT Security (Generate a 64-character random string for production)
JWT_SECRET="development_jwt_secret_key_change_in_production_min_32_chars"

# SMS OTP Provider ("beem_africa" | "africas_talking" | "dev_logger")
SMS_OTP_PROVIDER="dev_logger"

# Beem Africa Credentials (Tanzania SMS OTP Gateway)
BEEM_AFRICA_API_KEY=""
BEEM_AFRICA_SECRET_KEY=""
BEEM_AFRICA_SENDER_ID="LUMO"

# Africa's Talking Credentials (Optional Alternative SMS Gateway)
AFRICAS_TALKING_USERNAME=""
AFRICAS_TALKING_API_KEY=""

# AzamPay Mobile Money & Escrow Integration (M-Pesa, Tigo Pesa, Airtel Money)
AZAMPAY_ENVIRONMENT="sandbox" # "sandbox" or "production"
AZAMPAY_APP_NAME="Lumo Commerce"
AZAMPAY_CLIENT_ID=""
AZAMPAY_CLIENT_SECRET=""
AZAMPAY_ACCOUNT_NUMBER=""
AZAMPAY_WEBHOOK_SECRET=""

# Mongike Mobile Money Push Gateway (Tanzania Instant USSD Push)
MONGIKE_API_KEY="" # e.g. mk_...
MONGIKE_BASE_URL="https://mongike.com/api/v1"
MONGIKE_FEE_PAYER="MERCHANT" # "MERCHANT" or "BUYER"

# Distributed Rate Limiter (Optional - Redis / Upstash)
REDIS_URL=""

# Sentry Error Monitoring (Optional)
NEXT_PUBLIC_SENTRY_DSN=""
