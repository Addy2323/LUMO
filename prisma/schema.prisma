// ──────────────────────────────────────────────
// RFQ & Quotations Engine (Alibaba-Style Sourcing)
// ──────────────────────────────────────────────

enum RfqStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  QUOTED
  AWARDED
  CLOSED
  EXPIRED
  CANCELLED
}

enum QuotationStatus {
  DRAFT
  SUBMITTED
  REVISED
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

model RFQ {
  id                 String    @id @default(cuid())
  rfqNumber          String    @unique
  buyerId            String
  title              String
  description        String
  categoryId         String?
  targetDeliveryDate DateTime?
  destinationCity    String    @default("Dar es Salaam")
  destinationPort    String    @default("Dar es Salaam Port")
  incotermPreference String    @default("FOB")
  maxBudgetTZS       Decimal?  @db.Decimal(18, 4)
  status             RfqStatus @default(SUBMITTED)
  expiresAt          DateTime
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  buyer        User                @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  items        RFQItem[]
  requirements RFQRequirement[]
  attachments  RFQAttachment[]
  invitations  RFQInvitation[]
  quotations   SupplierQuotation[]

  @@index([buyerId, status])
  @@map("rfqs")
}

model RFQItem {
  id                 String   @id @default(cuid())
  rfqId              String
  productName        String
  specifications     String?
  quantity           Int
  unit               String   @default("pcs")
  targetUnitPriceTZS Decimal? @db.Decimal(18, 4)

  rfq RFQ @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  @@map("rfq_items")
}

model RFQRequirement {
  id              String  @id @default(cuid())
  rfqId           String
  requirementType String // e.g. "QUALITY_INSPECTION", "CE_CERTIFICATION", "SAMPLE_REQUIRED"
  description     String
  isMandatory     Boolean @default(true)

  rfq RFQ @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  @@map("rfq_requirements")
}

model RFQAttachment {
  id         String   @id @default(cuid())
  rfqId      String
  fileName   String
  fileUrl    String
  fileSize   Int
  mimeType   String
  uploadedAt DateTime @default(now())

  rfq RFQ @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  @@map("rfq_attachments")
}

model RFQInvitation {
  id         String   @id @default(cuid())
  rfqId      String
  supplierId String
  status     String   @default("SENT") // SENT, VIEWED, DECLINED, QUOTED
  sentAt     DateTime @default(now())

  rfq RFQ @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  @@map("rfq_invitations")
}

model SupplierQuotation {
  id                String          @id @default(cuid())
  quotationNumber   String          @unique
  rfqId             String
  supplierId        String
  version           Int             @default(1)
  status            QuotationStatus @default(SUBMITTED)
  validUntil        DateTime
  currency          String          @default("TZS")
  subtotalAmount    Decimal         @db.Decimal(18, 4)
  freightAmount     Decimal         @default(0) @db.Decimal(18, 4)
  taxAmount         Decimal         @default(0) @db.Decimal(18, 4)
  totalAmount       Decimal         @db.Decimal(18, 4)
  incoterm          String          @default("FOB")
  estimatedLeadDays Int             @default(14)
  sampleAvailable   Boolean         @default(false)
  originCountry     String          @default("China")
  inspectionTerms   String?
  paymentTerms      String?
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  rfq           RFQ                      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplierUser  User                     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  items         QuotationItem[]
  charges       QuotationCharge[]
  versions      QuotationVersion[]
  messages      QuotationMessage[]
  statusHistory QuotationStatusHistory[]

  @@index([rfqId, supplierId, status])
  @@map("supplier_quotations")
}

model QuotationItem {
  id              String  @id @default(cuid())
  quotationId     String
  itemDescription String
  quantity        Int
  unitPrice       Decimal @db.Decimal(18, 4)
  subtotal        Decimal @db.Decimal(18, 4)

  quotation SupplierQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@map("quotation_items")
}

model QuotationCharge {
  id          String  @id @default(cuid())
  quotationId String
  chargeName  String // e.g. "PORT_HANDLING", "DOCUMENTATION_FEE", "ORIGIN_INSPECTION"
  amount      Decimal @db.Decimal(18, 4)
  isIncluded  Boolean @default(true)

  quotation SupplierQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@map("quotation_charges")
}

model QuotationVersion {
  id            String   @id @default(cuid())
  quotationId   String
  versionNumber Int
  snapshotData  Json
  changeReason  String?
  createdAt     DateTime @default(now())

  quotation SupplierQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@map("quotation_versions")
}

model QuotationMessage {
  id          String   @id @default(cuid())
  quotationId String
  senderId    String
  senderRole  Role
  messageText String
  createdAt   DateTime @default(now())

  quotation SupplierQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@map("quotation_messages")
}

model QuotationStatusHistory {
  id             String          @id @default(cuid())
  quotationId    String
  previousStatus QuotationStatus
  newStatus      QuotationStatus
  changedById    String
  reason         String?
  createdAt      DateTime        @default(now())

  quotation SupplierQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@map("quotation_status_history")
}

// ──────────────────────────────────────────────
// Landed-Cost Engine & Multi-Currency Tariffs
// ──────────────────────────────────────────────

model ExchangeRate {
  id             String    @id @default(cuid())
  baseCurrency   String // e.g. "USD", "CNY", "EUR"
  targetCurrency String    @default("TZS")
  rate           Decimal   @db.Decimal(18, 6)
  source         String    @default("BOT_OFFICIAL") // BOT (Bank of Tanzania) or CENTRAL_BANK
  effectiveAt    DateTime  @default(now())
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([baseCurrency, targetCurrency, effectiveAt])
  @@map("exchange_rates")
}

model TariffCode {
  id          String   @id @default(cuid())
  hsCode      String   @unique // Harmonized System Code e.g. "8517.12.00"
  description String
  category    String // Electronics, Textiles, Industrial Machinery, Automotive
  createdAt   DateTime @default(now())

  dutyRates TariffDutyRate[]

  @@map("tariff_codes")
}

model TariffDutyRate {
  id                 String    @id @default(cuid())
  tariffCodeId       String
  importDutyPercent  Decimal   @db.Decimal(6, 2) // e.g. 25.00%
  vatPercent         Decimal   @default(18.00) @db.Decimal(6, 2) // Tanzania VAT 18.00%
  railwayLevyPercent Decimal   @default(1.50) @db.Decimal(6, 2) // RDL 1.50%
  whidLevyPercent    Decimal   @default(0.60) @db.Decimal(6, 2) // CESS / WHID 0.60%
  excisePercent      Decimal   @default(0.00) @db.Decimal(6, 2)
  effectiveFrom      DateTime  @default(now())
  effectiveTo        DateTime?

  tariffCode TariffCode @relation(fields: [tariffCodeId], references: [id], onDelete: Cascade)

  @@map("tariff_duty_rates")
}

model FreightRateCard {
  id                 String   @id @default(cuid())
  originCountry      String // e.g. "China", "UAE", "Turkey", "India"
  destinationPort    String   @default("Dar es Salaam Port")
  transportMode      String   @default("AIR") // AIR, SEA_FCL, SEA_LCL
  minWeightKg        Decimal  @default(1.0) @db.Decimal(10, 2)
  pricePerKgUSD      Decimal  @db.Decimal(10, 2)
  baseHandlingFeeUSD Decimal  @default(20.00) @db.Decimal(10, 2)
  estimatedDaysMin   Int      @default(5)
  estimatedDaysMax   Int      @default(10)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())

  @@index([originCountry, transportMode, isActive])
  @@map("freight_rate_cards")
}

// ──────────────────────────────────────────────
// Electronic Waybills & Cross-Border Logistics
// ──────────────────────────────────────────────

model ElectronicWaybill {
  id               String    @id @default(cuid())
  ewbNumber        String    @unique // Format: "EWB-TZ-2026-XXXXX"
  orderId          String?
  shipmentType     String    @default("AIR_CARGO") // AIR_CARGO, SEA_CONTAINER, GROUND_TRUCK
  originPort       String    @default("Guangzhou Baiyun Intl Airport")
  destinationPort  String    @default("Dar es Salaam Port (JNIA)")
  carrierName      String    @default("Ethiopian Airlines Cargo")
  vesselOrFlightNo String?
  containerNo      String?
  billOfLadingNo   String?
  departureDate    DateTime?
  estimatedArrival DateTime
  actualArrival    DateTime?
  status           String    @default("BOOKED") // BOOKED, IN_TRANSIT, PORT_CUSTOMS_CLEARANCE, CUSTOMS_CLEARED, OUT_FOR_DELIVERY, DELIVERED
  qrCodeData       String?
  digitalSignature String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  order           Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
  events          ShipmentEvent[]
  proofOfDelivery ProofOfDelivery?

  @@index([orderId, status])
  @@map("electronic_waybills")
}

model ShipmentEvent {
  id                String   @id @default(cuid())
  waybillId         String
  eventCode         String // e.g. "PICKED_UP", "DEPARTED_ORIGIN", "CUSTOMS_CLEARED", "DELIVERED"
  locationName      String // e.g. "Guangzhou, CN", "Dar es Salaam Port, TZ"
  statusDescription String
  eventTimestamp    DateTime @default(now())
  createdByRole     String   @default("LOGISTICS_AGENT")

  waybill ElectronicWaybill @relation(fields: [waybillId], references: [id], onDelete: Cascade)

  @@map("shipment_events")
}

model ProofOfDelivery {
  id                String   @id @default(cuid())
  waybillId         String   @unique
  recipientName     String
  recipientIdType   String? // NIDA, PASSPORT, VOTER_ID
  signaturePhotoUrl String?
  gpsLat            Float?
  gpsLng            Float?
  deliveredAt       DateTime @default(now())

  waybill ElectronicWaybill @relation(fields: [waybillId], references: [id], onDelete: Cascade)

  @@map("proof_of_deliveries")
}

// ──────────────────────────────────────────────
// Meseji SMS, Outbox & Campaign Messaging Models
// ──────────────────────────────────────────────

enum SmsCampaignType {
  TRANSACTIONAL
  SERVICE
  MARKETING
  SECURITY
}

enum SmsCampaignStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SCHEDULED
  QUEUED
  SENDING
  COMPLETED
  PARTIALLY_FAILED
  FAILED
  CANCELLED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  DEAD_LETTER
}

model SmsTemplate {
  id              String   @id @default(cuid())
  templateKey     String   @unique // e.g. "REGISTRATION_OTP", "ORDER_PAID_CUSTOMER"
  name            String
  campaignType    SmsCampaignType @default(TRANSACTIONAL)
  language        String   @default("en") // "en" | "sw"
  templateTextEn  String
  templateTextSw  String
  version         Int      @default(1)
  isApproved      Boolean  @default(true)
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("sms_templates")
}

model SmsCampaign {
  id                   String            @id @default(cuid())
  campaignName         String
  campaignType         SmsCampaignType   @default(MARKETING)
  senderId             String            @default("LUMO")
  language             String            @default("sw")
  templateKey          String?
  messageContent       String
  audienceFilter       String            // JSON snapshot of audience criteria
  recipientCount       Int               @default(0)
  excludedCount        Int               @default(0)
  estimatedSegments    Int               @default(1)
  estimatedCostTzs     Decimal           @default(0.00) @db.Decimal(10, 2)
  actualCostTzs        Decimal           @default(0.00) @db.Decimal(10, 2)
  status               SmsCampaignStatus @default(DRAFT)
  createdById          String
  approvedById         String?
  scheduledTime        DateTime?
  startedTime          DateTime?
  completedTime        DateTime?
  providerBatchIds     String[]          @default([])
  failureReason        String?
  auditMetadata        String?           // Sanitized audit JSON
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  recipients SmsCampaignRecipient[]
  batches    SmsBatch[]

  @@index([status, scheduledTime])
  @@map("sms_campaigns")
}

model SmsCampaignRecipient {
  id            String   @id @default(cuid())
  campaignId    String
  userId        String?
  phoneE164     String
  status        String   @default("QUEUED") // QUEUED, DELIVERED, FAILED, OPTED_OUT
  deliveredAt   DateTime?
  failureReason String?

  campaign SmsCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, phoneE164])
  @@map("sms_campaign_recipients")
}

model SmsBatch {
  id               String   @id @default(cuid())
  batchId          String   @unique // Meseji provider batch ID
  campaignId       String?
  provider         String   @default("meseji")
  senderId         String   @default("LUMO")
  totalRecipients  Int      @default(0)
  successfulCount  Int      @default(0)
  failedCount      Int      @default(0)
  successRate      Decimal  @default(0.00) @db.Decimal(5, 2)
  status           String   @default("queued") // queued, completed, partially_failed, failed
  lastPolledAt     DateTime?
  completedAt      DateTime?
  createdAt        DateTime @default(now())

  campaign SmsCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  attempts SmsMessageAttempt[]

  @@index([batchId])
  @@map("sms_batches")
}

model SmsMessageAttempt {
  id            String   @id @default(cuid())
  batchId       String?
  recipientE164 String
  messageId     String?
  status        String   @default("QUEUED")
  attemptsCount Int      @default(1)
  errorDetails  String?
  createdAt     DateTime @default(now())

  batch SmsBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@map("sms_message_attempts")
}

model NotificationOutbox {
  id              String       @id @default(cuid())
  eventType       String       // e.g. "ORDER_PAID", "ORDER_DELIVERED", "OTP_REQUEST"
  aggregateId     String       // e.g. orderId, userId, or challengeId
  recipientId     String       // userId or phoneE164
  recipientPhone  String
  channel         String       @default("SMS")
  templateKey     String
  templateVersion Int          @default(1)
  payloadJson     String       // Render parameters JSON
  status          OutboxStatus @default(PENDING)
  retryCount      Int          @default(0)
  maxRetries      Int          @default(5)
  nextAttemptAt   DateTime     @default(now())
  processedAt     DateTime?
  providerBatchId String?
  errorMessage    String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // Strict idempotency constraint preventing duplicate notifications
  @@unique([eventType, aggregateId, recipientId, templateVersion], name: "outbox_idempotency_idx")
  @@index([status, nextAttemptAt])
  @@map("notification_outbox")
}

model NotificationPreference {
  id                    String   @id @default(cuid())
  userId                String   @unique
  transactionalSmsEnabled Boolean @default(true)
  marketingSmsEnabled     Boolean @default(true)
  orderStatusSmsEnabled   Boolean @default(true)
  securitySmsEnabled      Boolean @default(true)
  optedOutAt            DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("notification_preferences")
}

model SmsProviderAccountSnapshot {
  id                   String   @id @default(cuid())
  provider             String   @default("meseji")
  totalMessagesSent    Int      @default(0)
  successfulDeliveries Int      @default(0)
  failedDeliveries     Int      @default(0)
  successRate          Decimal  @default(0.00) @db.Decimal(5, 2)
  balanceTzs           Decimal? @db.Decimal(12, 2)
  snapshotAt           DateTime @default(now())

  @@map("sms_provider_account_snapshots")
}

// ──────────────────────────────────────────────
// Order Assignment Engine
// ──────────────────────────────────────────────

enum AssignmentRole {
  SALES
  AGENT
  SUPPLIER
  INSPECTOR
  LOGISTICS
}

enum AssignmentStatus {
  UNASSIGNED
  OFFERED
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  REJECTED
  EXPIRED
  REASSIGNED
  CANCELLED
}

model OrderAssignment {
  id                      String           @id @default(uuid())
  orderId                 String
  sourcingRequestId       String?
  assignmentRole          AssignmentRole   @default(SALES)
  assigneeId              String?
  assigneeOrganizationId  String?
  assignedById            String?
  status                  AssignmentStatus @default(UNASSIGNED)
  priority                String           @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  reason                  String?
  instructions            String?
  offeredAt               DateTime?
  expiresAt               DateTime?
  acceptedAt              DateTime?
  startedAt               DateTime?
  completedAt             DateTime?
  slaDueAt                DateTime?
  rejectedAt              DateTime?
  rejectionReason         String?
  unassignedAt            DateTime?
  reassignmentReason      String?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  version                 Int              @default(1)

  assigneeOrganization Organization?    @relation(fields: [assigneeOrganizationId], references: [id])
  events               AssignmentEvent[]

  @@index([orderId, assignmentRole, status])
  @@index([assigneeId, status])
  @@index([assigneeOrganizationId, status])
  @@map("order_assignments")
}

// ──────────────────────────────────────────────
// Multi-Role Identity & Organizations
// ──────────────────────────────────────────────

model UserRole {
  id            String         @id @default(uuid())
  userId        String
  role          Role
  status        UserRoleStatus @default(PENDING)
  approvedAt    DateTime?
  approvedById  String?
  revokedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId, status])
  @@map("user_roles")
}

model UserRoleAssignment {
  id           String       @id @default(cuid())
  userId       String
  role         PlatformRole
  status       RoleStatus   @default(ACTIVE)
  approvedAt   DateTime?
  approvedById String?
  revokedAt    DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
  @@index([userId, status])
  @@map("user_role_assignments")
}

model Organization {
  id                 String           @id @default(uuid())
  name               String
  type               OrganizationType
  registrationNumber String?
  tinNumber          String?
  verified           Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  members     OrganizationMember[]
  assignments OrderAssignment[]

  @@map("organizations")
}

model OrganizationMember {
  id             String             @id @default(uuid())
  organizationId String
  userId         String
  position       MembershipPosition @default(VIEWER)
  isActive       Boolean            @default(true)
  joinedAt       DateTime           @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId, isActive])
  @@map("organization_members")
}

// ──────────────────────────────────────────────
// Assignment Events (Audit Trail)
// ──────────────────────────────────────────────

model AssignmentEvent {
  id           String   @id @default(uuid())
  assignmentId String
  eventType    String   // OFFERED, ACCEPTED, REJECTED, EXPIRED, REASSIGNED, COMPLETED, CANCELLED
  actorId      String?
  details      String?
  createdAt    DateTime @default(now())

  assignment OrderAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  actor      User?           @relation("AssignmentActor", fields: [actorId], references: [id])

  @@index([assignmentId, createdAt])
  @@map("assignment_events")
}

// ──────────────────────────────────────────────
// Conversations & Messaging
// ──────────────────────────────────────────────

model Conversation {
  id                String                   @id @default(uuid())
  orderId           String?
  sourcingRequestId String?
  supportTicketId   String?
  disputeId         String?
  visibility        ConversationVisibility   @default(CUSTOMER_VISIBLE)
  title             String?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@index([orderId])
  @@index([sourcingRequestId])
  @@map("conversations")
}

model ConversationParticipant {
  id             String    @id @default(uuid())
  conversationId String
  userId         String
  role           Role
  joinedAt       DateTime  @default(now())
  lastReadAt     DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@map("conversation_participants")
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  senderId       String
  senderRole     Role
  content        String
  isInternal     Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User              @relation(fields: [senderId], references: [id])
  attachments  MessageAttachment[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

model MessageAttachment {
  id         String   @id @default(uuid())
  messageId  String
  fileName   String
  fileUrl    String
  fileSize   Int
  mimeType   String
  uploadedAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("message_attachments")
}

// ──────────────────────────────────────────────
// In-App Notifications
// ──────────────────────────────────────────────

model InAppNotification {
  id           String   @id @default(uuid())
  userId       String
  eventType    String   // ORDER_PAID, ASSIGNMENT_OFFERED, MESSAGE_RECEIVED, etc.
  title        String
  body         String?
  resourceType String?  // ORDER, SOURCING_REQUEST, ASSIGNMENT, CONVERSATION
  resourceId   String?
  isRead       Boolean  @default(false)
  readAt       DateTime?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@map("in_app_notifications")
}

