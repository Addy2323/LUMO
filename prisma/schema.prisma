// LUMO Digital Commerce Platform - PostgreSQL Prisma Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────
// Enums
// ──────────────────────────────────────────────

enum Role {
  BUYER
  CUSTOMER
  SUPPLIER
  SALES
  LOGISTICS
  AGENT
  ADMIN
}

enum PlatformRole {
  BUYER
  SUPPLIER
  SALES
  LOGISTICS
  AGENT
  ADMIN
}

enum RoleStatus {
  ACTIVE
  PENDING_APPROVAL
  REVOKED
  SUSPENDED
}

enum AccountStatus {
  PENDING_PHONE_VERIFICATION
  ACTIVE
  SUSPENDED
}

enum OtpPurpose {
  PHONE_REGISTRATION
  PASSWORD_RESET
}


enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  MORE_INFORMATION_REQUIRED
  APPROVED
  REJECTED
  WITHDRAWN
}

enum PartnerStatus {
  PENDING_ACTIVATION
  ACTIVE
  SUSPENDED
  TERMINATED
}

enum ApplicationType {
  SUPPLIER
  LOGISTICS
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum OrderStatus {
  DRAFT
  PENDING_PAYMENT
  PAID
  PROCESSING
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELLED
  REFUNDED
  DISPUTED
}

enum PaymentStatus {
  PENDING
  SUCCESSFUL
  FAILED
  CANCELLED
  REVERSED
  REFUNDED
}

enum EscrowStatus {
  INITIATED
  HELD
  RELEASED
  REFUNDED
  DISPUTED
}

enum FreightMode {
  AIR
  SEA
}

enum SourcingStatus {
  SUBMITTED
  UNDER_REVIEW
  QUOTED
  ACCEPTED
  FULFILLED
  REJECTED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ProductStatus {
  IMPORTED
  DRAFT
  PENDING_REVIEW
  APPROVED
  PUBLISHED
  REJECTED
  ARCHIVED
  OUT_OF_STOCK
  DISCONTINUED
}

enum UserRoleStatus {
  PENDING
  APPROVED
  SUSPENDED
  REVOKED
}

enum OrganizationType {
  CUSTOMER_BUSINESS
  SUPPLIER
  LOGISTICS_COMPANY
  LUMO_INTERNAL
}

enum MembershipPosition {
  OWNER
  MANAGER
  SALES_OFFICER
  DISPATCHER
  DRIVER
  OPERATOR
  VIEWER
}

enum ConversationVisibility {
  CUSTOMER_VISIBLE
  ASSIGNED_PARTICIPANTS
  LUMO_INTERNAL
  ADMIN_SECURITY
}

enum NotificationType {
  SECURITY
  TRANSACTIONAL
  SERVICE
  MARKETING
}

enum NotificationChannel {
  IN_APP
  SMS
  EMAIL
}

enum SourceType {
  DEMO
  CSV_IMPORT
  EXCEL_IMPORT
  MANUAL
  LUMO_AGENT
  LUMO_SUPPLIER
  MANUFACTURER
  WHOLESALER
  MARKETPLACE_REFERENCE
}

enum ImportStatus {
  PROCESSING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}

enum ImportRowStatus {
  PENDING
  IMPORTED
  SKIPPED
  FAILED
}

// ──────────────────────────────────────────────
// Core User, Auth & Sessions
// ──────────────────────────────────────────────

model User {
  id                      String        @id @default(uuid())
  email                   String        @unique
  passwordHash            String?
  name                    String
  role                    Role          @default(BUYER)
  phone                   String?
  companyName             String?
  kycStatus               KycStatus     @default(PENDING)
  phoneVerifiedAt         DateTime?
  accountStatus           AccountStatus @default(PENDING_PHONE_VERIFICATION)
  authenticationHoldUntil DateTime?
  lastSuccessfulLoginAt   DateTime?
  passwordChangedAt       DateTime?
  securityReviewRequired  Boolean       @default(false)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  sessions                   Session[]
  passwordResets             PasswordResetToken[]
  otpChallenges              OtpChallenge[]
  passwordResetAuths        PasswordResetAuthorization[]
  webAuthnCredentials       WebAuthnCredential[]
  webAuthnChallenges        WebAuthnChallenge[]
  securityEvents            AuthSecurityEvent[]
  orders                     Order[]
  sourcingRequests           SourcingRequest[]
  disputes                   Dispute[]
  supplierProfile            Supplier?
  productImports             ProductImport[]
  addresses                  Address[]
  wishlist                   WishlistItem[]
  cartItems                  CartItem[]
  auditLogs                  AuditLog[]
  escrowBuyer                EscrowLedger[]               @relation("EscrowBuyer")
  escrowSupplier             EscrowLedger[]               @relation("EscrowSupplier")
  applications               PartnerApplication[]         @relation("ApplicantUser")
  assignedReviews            PartnerApplication[]         @relation("AssignedReviewer")
  consentRecords             ConsentRecord[]
  rfqs                       RFQ[]
  supplierQuotations         SupplierQuotation[]
  userRoles                  UserRole[]
  roleAssignments            UserRoleAssignment[]
  organizationMemberships    OrganizationMember[]
  conversationParticipants   ConversationParticipant[]
  sentMessages               Message[]
  inAppNotifications         InAppNotification[]
  assignmentEvents           AssignmentEvent[]            @relation("AssignmentActor")

  @@map("users")
}

// ──────────────────────────────────────────────
// Onboarding & Partner Applications
// ──────────────────────────────────────────────

model PartnerApplication {
  id                 String            @id @default(uuid())
  version            Int               @default(1)
  userId             String
  applicationType    ApplicationType
  status             ApplicationStatus @default(DRAFT)
  currentStep        Int               @default(1)
  draftData          Json?
  submissionDate     DateTime?
  assignedReviewerId String?
  decisionDate       DateTime?
  decisionReason     String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  user               User                       @relation("ApplicantUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedReviewer   User?                      @relation("AssignedReviewer", fields: [assignedReviewerId], references: [id])
  supplierProfile    SupplierProfile?
  logisticsProfile   LogisticsProfile?
  documents          ApplicationDocument[]
  reviewNotes        ApplicationReviewNote[]
  messages           ApplicationMessage[]
  statusHistory      ApplicationStatusHistory[]
  verificationChecks VerificationCheck[]
  consentRecords     ConsentRecord[]

  @@map("partner_applications")
}

model SupplierProfile {
  id                       String        @id @default(uuid())
  applicationId            String        @unique
  userId                   String        @unique
  registeredName           String
  tradingName              String?
  registrationNumber       String
  tinNumber                String
  countryOfRegistration    String        @default("Tanzania")
  businessAddress          String
  website                  String?
  marketplaceProfile       String?
  contactPerson            String
  contactPosition          String
  yearEstablished          Int?
  employeeCount            String?
  supplierType             String
  mainCategories           String[]
  productDescription       String
  brandsSupplied           String[]      @default([])
  manufacturingStatus      String?
  moq                      Int           @default(1)
  monthlyCapacity          String?
  countriesServed          String[]      @default([])
  shippingOrigin           String?
  warehouseLocation        String?
  inventoryAvailability    String?
  orderProcessingTime      String?
  supportedShippingMethods String[]      @default([])
  returnPolicy             String?
  warrantyArrangements     String?
  qualityControlProcess    String?
  inspectionAvailable      Boolean       @default(false)
  incoterms                String[]      @default([])
  supportedCurrencies      String[]      @default(["TZS", "USD"])
  partnerStatus            PartnerStatus @default(PENDING_ACTIVATION)
  createdAt                DateTime      @default(now())
  updatedAt                DateTime      @updatedAt

  application PartnerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("supplier_profiles")
}

model LogisticsProfile {
  id                    String        @id @default(uuid())
  applicationId         String        @unique
  userId                String        @unique
  companyName           String
  tradingName           String?
  registrationNumber    String
  tinNumber             String
  countryOfRegistration String        @default("Tanzania")
  officeAddress         String
  website               String?
  contactPerson         String
  contactPosition       String
  yearsInOperation      Int?
  employeeCount         String?
  servicesOffered       String[]
  countriesOfOperation  String[]      @default([])
  portsServed           String[]      @default([])
  airportsServed        String[]      @default([])
  tanzaniaRegions       String[]      @default([])
  warehouseLocations    String[]      @default([])
  fleetSize             Int?
  vehicleTypes          String[]      @default([])
  shipmentCapacity      String?
  avgDeliveryTimes      String?
  trackingCapabilities  String?
  podCapabilities       String?
  apiIntegration        Boolean       @default(false)
  supportedCargoTypes   String[]      @default([])
  restrictedCargo       String[]      @default([])
  rateStructure         String?
  minShipmentReq        String?
  paymentTerms          String?
  insuranceCoverage     String?
  claimsProcedure       String?
  slas                  String?
  supportedCurrencies   String[]      @default(["TZS", "USD"])
  supportAvailability   String?
  escalationContacts    String?
  operatingHours        String?
  partnerStatus         PartnerStatus @default(PENDING_ACTIVATION)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  application PartnerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("logistics_profiles")
}

model ApplicationDocument {
  id               String   @id @default(uuid())
  applicationId    String
  documentCategory String // e.g. "BUSINESS_LICENSE", "TIN_CERTIFICATE", "DIRECTOR_ID"
  fileName         String
  originalName     String
  fileSize         Int
  mimeType         String
  storageKey       String // Private storage key path
  fileHash         String? // SHA-256 checksum for integrity
  verifiedStatus   Boolean  @default(false)
  rejectionReason  String?
  uploadedAt       DateTime @default(now())

  application PartnerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("application_documents")
}

model ApplicationReviewNote {
  id            String   @id @default(uuid())
  applicationId String
  authorId      String
  authorName    String
  noteText      String
  createdAt     DateTime @default(now())

  application PartnerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("application_review_notes")
}

model ApplicationMessage {
  id            String   @id @default(uuid())
  applicationId String
  senderId      String
  senderName    String
  senderRole    Role
  message       String
  createdAt     DateTime @default(now())

  application PartnerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("application_messages")
}

model ApplicationStatusHistory {
  id             String            @id @default(uuid())
  applicationId  String
  previousStatus ApplicationStatus
  newStatus      ApplicationStatus
  changedById    String
  changedByName  String
  reason         String?
  createdAt      DateTime          @default(now())

  application PartnerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("application_status_history")
}

model VerificationCheck {
  id            String   @id @default(uuid())
  applicationId String
  checkType     String // e.g. "TIN_VERIFICATION", "ID_CHECK", "DOC_AUTHENTICITY"
  verifiedBy    String
  passed        Boolean  @default(true)
  notes         String?
  checkedAt     DateTime @default(now())

  application PartnerApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("verification_checks")
}

model ConsentRecord {
  id             String   @id @default(uuid())
  userId         String
  applicationId  String?
  consentType    String // "TERMS_OF_SERVICE", "PRIVACY_POLICY", "PARTNER_AGREEMENT"
  termsVersion   String   @default("1.0")
  privacyVersion String   @default("1.0")
  ipAddress      String?
  userAgent      String?
  consentedAt    DateTime @default(now())

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  application PartnerApplication? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@map("consent_records")
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  sessionToken String   @unique
  activeRole   Role?
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model OtpCode {
  id                String   @id @default(uuid())
  identifier        String // Phone or Email
  hashedCode        String
  purpose           String   @default("LOGIN_OR_REGISTER") // "LOGIN", "REGISTER", "RESET"
  attempts          Int      @default(0)
  resendAvailableAt DateTime
  expiresAt         DateTime
  createdAt         DateTime @default(now())

  @@index([identifier])
  @@map("otp_codes")
}

model PasswordResetToken {
  id          String   @id @default(uuid())
  userId      String
  hashedToken String   @unique
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model OtpChallenge {
  id                String      @id @default(uuid())
  userId            String?
  phoneTargetHash   String
  purpose           OtpPurpose
  codeHash          String
  expiresAt         DateTime
  attemptCount      Int         @default(0)
  maxAttempts       Int         @default(5)
  resendCount       Int         @default(0)
  resendAvailableAt DateTime
  consumedAt        DateTime?
  invalidatedAt     DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phoneTargetHash, purpose])
  @@index([userId, purpose])
  @@map("otp_challenges")
}

model PasswordResetAuthorization {
  id          String     @id @default(uuid())
  userId      String
  challengeId String
  tokenHash   String     @unique
  purpose     OtpPurpose @default(PASSWORD_RESET)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
  @@map("password_reset_authorizations")
}

model AuthSecurityEvent {
  id                String   @id @default(uuid())
  eventType         String
  userId            String?
  accountTargetHash String?
  ipHash            String?
  deviceHash        String?
  endpoint          String
  purpose           String?
  action            String
  riskLevel         String   @default("LOW") // LOW, MEDIUM, HIGH, CRITICAL
  correlationId     String?
  details           String?
  createdAt         DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([accountTargetHash, createdAt])
  @@index([ipHash, createdAt])
  @@index([eventType, createdAt])
  @@map("auth_security_events")
}

model WebAuthnCredential {
  id             String    @id @default(uuid())
  userId         String
  credentialId   String    @unique
  publicKey      String
  signCount      BigInt    @default(0)
  transports     String?   // Comma-separated list: "internal,usb,ble,nfc"
  backupEligible Boolean   @default(false)
  backupState    Boolean   @default(false)
  deviceLabel    String?
  revokedAt      DateTime?
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("webauthn_credentials")
}

model WebAuthnChallenge {
  id        String   @id @default(uuid())
  userId    String
  challenge String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("webauthn_challenges")
}

model Address {
  id        String   @id @default(uuid())
  userId    String
  fullName  String
  phone     String
  street    String
  city      String   @default("Dar es Salaam")
  region    String   @default("Dar es Salaam")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlist_items")
}

model CartItem {
  id              String   @id @default(uuid())
  userId          String
  productId       String
  quantity        Int      @default(1)
  selectedVariant String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, selectedVariant])
  @@map("cart_items")
}

// ──────────────────────────────────────────────
// Supplier
// ──────────────────────────────────────────────

model Supplier {
  id          String   @id @default(uuid())
  userId      String   @unique
  companyName String
  country     String
  hubLocation String?
  verified    Boolean  @default(false)
  rating      Float    @default(4.8)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products Product[]

  @@map("suppliers")
}

// ──────────────────────────────────────────────
// Category (hierarchical)
// ──────────────────────────────────────────────

model Category {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  icon        String?
  description String?
  parentId    String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@map("categories")
}

// ──────────────────────────────────────────────
// Product (LUMO-owned catalog)
// ──────────────────────────────────────────────

model Product {
  id               String  @id @default(uuid())
  productCode      String  @unique @default("")
  title            String
  slug             String  @unique
  shortDescription String?
  description      String
  categoryId       String
  brand            String?

  status ProductStatus @default(IMPORTED)

  // Pricing using Decimal for exact financial precision
  priceTZS       Decimal  @db.Decimal(14, 2)
  priceUSD       Decimal  @db.Decimal(12, 2)
  costPriceUSD   Decimal? @db.Decimal(12, 2)
  compareAtPrice Decimal? @db.Decimal(14, 2)

  sourceType      SourceType @default(MANUAL)
  sourcePlatform  String?
  sourceProductId String?
  sourceUrl       String?

  moq             Int     @default(1)
  stock           Int     @default(0)
  weight          Float?
  length          Float?
  width           Float?
  height          Float?
  material        String?
  countryOfOrigin String?

  sourceHub String   @default("LUMO Direct")
  imageUrl  String   @default("")
  gallery   String[] @default([])
  specs     Json?
  variants  Json?

  rating     Float   @default(0)
  totalSales Int     @default(0)
  isApproved Boolean @default(false)

  agentId    String?
  supplierId String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?

  category        Category               @relation(fields: [categoryId], references: [id])
  supplier        Supplier?              @relation(fields: [supplierId], references: [id])
  orderItems      OrderItem[]
  images          ProductImage[]
  productVariants ProductVariantRecord[]
  priceTiers      ProductPriceTier[]
  importRows      ProductImportRow[]
  auditLogs       CatalogAuditLog[]
  wishlistItems   WishlistItem[]
  cartItems       CartItem[]

  @@map("products")
}

model ProductPriceTier {
  id          String    @id @default(cuid())
  productId   String
  minQuantity Int
  maxQuantity Int?
  unitPrice   Decimal   @db.Decimal(18, 4)
  currency    String    @default("TZS")
  validFrom   DateTime  @default(now())
  validUntil  DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, minQuantity, currency])
  @@index([productId, isActive])
  @@map("product_price_tiers")
}

model ProductImage {
  id          String   @id @default(uuid())
  productId   String
  storageUrl  String
  originalUrl String?
  altText     String?
  sortOrder   Int      @default(0)
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model ProductVariantRecord {
  id        String   @id @default(uuid())
  productId String
  sku       String?
  name      String
  options   Json
  priceTZS  Decimal? @db.Decimal(14, 2)
  priceUSD  Decimal? @db.Decimal(12, 2)
  costPrice Decimal? @db.Decimal(12, 2)
  stock     Int      @default(0)
  weight    Float?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_variants")
}

model ProductImport {
  id            String       @id @default(uuid())
  fileName      String
  fileType      String       @default("csv")
  totalRows     Int          @default(0)
  importedCount Int          @default(0)
  skippedCount  Int          @default(0)
  failedCount   Int          @default(0)
  warningCount  Int          @default(0)
  status        ImportStatus @default(PROCESSING)
  columnMapping Json?
  templateName  String?
  adminId       String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  admin User               @relation(fields: [adminId], references: [id])
  rows  ProductImportRow[]

  @@map("product_imports")
}

model ProductImportRow {
  id        String          @id @default(uuid())
  importId  String
  rowNumber Int
  rawData   Json
  status    ImportRowStatus @default(PENDING)
  errors    Json?
  warnings  Json?
  productId String?
  createdAt DateTime        @default(now())

  import  ProductImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  product Product?      @relation(fields: [productId], references: [id])

  @@map("product_import_rows")
}

model CatalogAuditLog {
  id            String   @id @default(uuid())
  productId     String?
  action        String
  adminName     String
  previousValue String?
  newValue      String?
  details       String?
  createdAt     DateTime @default(now())

  product Product? @relation(fields: [productId], references: [id])

  @@map("catalog_audit_logs")
}

// ──────────────────────────────────────────────
// Orders & Commerce
// ──────────────────────────────────────────────

model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique
  buyerId         String
  subtotalTZS     Decimal     @db.Decimal(14, 2)
  shippingFeeTZS  Decimal     @default(0) @db.Decimal(14, 2)
  taxAmountTZS    Decimal     @default(0) @db.Decimal(14, 2)
  discountTZS     Decimal     @default(0) @db.Decimal(14, 2)
  totalAmountTZS  Decimal     @db.Decimal(14, 2)
  status          OrderStatus @default(PENDING_PAYMENT)
  paymentMethod   String      @default("AzamPay Escrow")
  shippingAddress Json?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  buyer         User                @relation(fields: [buyerId], references: [id])
  items         OrderItem[]
  shipments     Shipment[]
  disputes      Dispute[]
  payments      PaymentRecord[]
  escrowRecords EscrowLedger[]
  waybills      ElectronicWaybill[]

  @@map("orders")
}

model OrderItem {
  id              String  @id @default(uuid())
  orderId         String
  productId       String
  quantity        Int
  unitPriceTZS    Decimal @db.Decimal(14, 2)
  totalPriceTZS   Decimal @db.Decimal(14, 2)
  selectedVariant String?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model PaymentRecord {
  id             String        @id @default(uuid())
  orderId        String
  provider       String        @default("AzamPay") // "AzamPay", "M-Pesa", "AirtelMoney"
  transactionRef String        @unique
  amountTZS      Decimal       @db.Decimal(14, 2)
  status         PaymentStatus @default(PENDING)
  channel        String? // "M-PESA", "HALOPESA", "AIRTEL", "CARD"
  rawPayload     Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payment_records")
}

model EscrowLedger {
